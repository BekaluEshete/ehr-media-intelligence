# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Environment — never commit real keys
.env

# Runtime data — generated on first run
backend/data/ehr.db
backend/data/faiss_index/
