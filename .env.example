# Copy this to .env and fill in real values

# --- LLM Provider ---
# Pick ONE provider and set its key.
# Gemini is free (no credit card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
LLM_PROVIDER=gemini

# Anthropic Claude (paid, $5 min top-up)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic

# OpenAI (paid, $5 min top-up)
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai

# Leave LLM_PROVIDER=stub to run without any key (demo/test mode)

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./data/ehr.db

# FHIR bundles storage directory
FHIR_BUNDLES_DIR=./data/fhir_bundles

# AI summary cache directory
CACHE_DIR=./data/cache

# FAISS index directory
FAISS_INDEX_DIR=./data/faiss_index

# Server
HOST=0.0.0.0
PORT=8000
